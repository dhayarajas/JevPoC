# Copy to .env (git-ignored) or export in your shell. Leave the key unset to use the offline mock.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.14.0
# JEV_BACKEND=mock          # force the mock even when a key is set
# JEV_MOCK_FAIL_RATE=0.0    # mock only: share of calls that fail with HTTP 529
# JEV_MOCK_SLOW_RATE=0.0    # mock only: share of calls that take 0.9-1.5 s
# JEV_MOCK_REALTIME=0       # mock only: 1 = actually sleep for the simulated latency
# JEV_MASK_SALT=change-me   # HMAC salt for identifier tokens
